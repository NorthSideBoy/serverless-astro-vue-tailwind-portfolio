---
import type { InlineNode } from '../../data/schemas/article';
import { content, type Locale } from '../../data/content';
import { isExternalArticleLink } from './link';

interface Props { nodes: InlineNode[]; locale: Locale; footnote: (id: string) => number }
const { nodes, locale, footnote } = Astro.props;
const copy = content[locale];
const escape = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;');
const marks = (text: string, list: readonly string[] = []) => list.reduce((value, mark) => {
  if (mark === 'strong') return `<strong class="font-semibold text-ink">${value}</strong>`;
  if (mark === 'em') return `<em class="italic text-ink">${value}</em>`;
  if (mark === 'underline') return `<u class="underline decoration-1 underline-offset-4">${value}</u>`;
  if (mark === 'strike') return `<s class="line-through">${value}</s>`;
  if (mark === 'code') return `<code class="rounded-[3px] border border-line bg-sunken px-1.5 py-0.5 font-mono text-[0.86em] text-cyan">${value}</code>`;
  return value;
}, escape(text));
interface Part { html?: string; br?: boolean; href?: string; external?: boolean; footnote?: number; id?: string }
const parts: Part[] = nodes.map((node): Part => {
  if (node.type === 'text') return { html: marks(node.text, node.marks) };
  if (node.type === 'break') return { br: true };
  if (node.type === 'link') {
    return {
      html: node.children.map((child) => child.type === 'break' ? '<br>' : marks(child.text, child.marks)).join(''),
      href: node.href,
      external: isExternalArticleLink(node.href),
    };
  }
  return { footnote: footnote(node.id), id: node.id };
});
---
{parts.map((part) => {
  if (part.br) return <br />;
  if (part.footnote) return (
    <sup class="ml-0.5">
      <a id={`fnref-${part.id}`} href={`#fn-${part.id}`} aria-label={`${copy.articlePage.footnoteRef} ${part.footnote}`} class="font-mono text-[0.72em] font-medium text-soft underline decoration-soft/50 underline-offset-2 transition hover:decoration-soft">{part.footnote}</a>
    </sup>
  );
  if (part.href) return (
    <a href={part.href} target={part.external ? '_blank' : undefined} rel={part.external ? 'noopener noreferrer' : undefined} class="font-medium text-soft underline decoration-soft/50 decoration-1 underline-offset-4 transition hover:decoration-soft">
      <Fragment set:html={part.html} />
      {part.external && <Fragment set:html={'<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="mb-0.5 ml-0.5 inline-block" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>' + `<span class="sr-only">(${escape(copy.ui.opensInNewTab)})</span>`} />}
    </a>
  );
  return <Fragment set:html={part.html} />;
})}
