---
import SiteHeader from '@/components/chrome/astro/SiteHeader.astro';
import SiteFooter from '@/components/chrome/astro/SiteFooter.astro';
import ReviewsAccess from '@/components/islands/reviews/ReviewsAccessIsland.vue';
import Layout from '@/layouts/Layout.astro';
import { content, type Locale } from '@/data/content';

const { locale } = Astro.props as { locale: Locale };
const path = Astro.url.pathname;
const copy = content[locale];
---
<Layout
  locale={locale}
  title={copy.reviews.meta.accessTitle}
  description={copy.reviews.meta.accessDescription}
  indexable={false}
>
  <SiteHeader page="reviews" locale={locale} path={path} />
  <ReviewsAccess locale={locale} page="reviews" path={path} client:load />
  <SiteFooter page="reviews" locale={locale} path={path} />
</Layout>
