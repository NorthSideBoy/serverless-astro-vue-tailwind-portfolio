---
import { iconPaths, brandIcons } from './icons';
interface Props { name: string; size?: number; strokeWidth?: number; class?: string }
const { name, size = 20, strokeWidth = 1.6, class: className } = Astro.props;
const body = iconPaths[name] ?? '';
const brand = brandIcons.has(name);
---
{brand ? (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class={className}>
    <path d={body} />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class={className} set:html={body} />
)}
