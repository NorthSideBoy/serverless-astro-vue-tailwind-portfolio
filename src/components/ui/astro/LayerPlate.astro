---
interface LayerInfo { index: string; label: string; detail: string }
const { layers } = Astro.props as { layers: LayerInfo[] };
const colors = ['var(--c-layer-1)', 'var(--c-layer-2)', 'var(--c-layer-3)', 'var(--c-layer-4)'];
const radii = [54, 96, 138, 180];
const point = (ring: number, node: number) => {
  const angle = (node / (6 + ring * 2)) * Math.PI * 2 + ring * Math.PI / 12;
  const radius = (radii[ring] ?? 54 + ring * 42) * (ring === 1 ? 1.08 : 1);
  return { x: 340 + radius * Math.cos(angle), y: 225 + radius * Math.sin(angle) };
};
const links = layers.slice(0, -1).flatMap((_, ring) => Array.from({ length: 6 + ring * 2 }, (_, node) => {
  const angle = (node / (6 + ring * 2)) * Math.PI * 2 + ring * Math.PI / 12;
  const count = 8 + ring * 2;
  const outer = ((Math.round((angle - (ring + 1) * Math.PI / 12) / (Math.PI * 2 / count)) % count) + count) % count;
  return { ring: ring + 1, from: point(ring, node), to: point(ring + 1, outer) };
}));
---
<div class="plate-root" aria-hidden="true" data-layer-plate><svg viewBox="0 0 680 450" focusable="false" class="block h-full w-full">
  <path d="M8 16V8h8M664 8h8v8M8 434v8h8M664 442h8v-8" fill="none" stroke="var(--c-line-strong)" stroke-width="1" opacity="0.8" />
  <circle cx="340" cy="225" r="202" fill="none" stroke="var(--c-line-strong)" stroke-width="1" stroke-dasharray="2 12" opacity="0.42" />
  {[...layers].reverse().map((_, reverse) => { const i = layers.length - reverse - 1; return <circle data-disc={i} cx="340" cy="225" r={(radii[i] ?? 54 + i * 42) * (i === 1 ? 1.08 : 1)} fill={colors[i % 4]} fill-opacity={i === 1 ? 0.09 : 0.025} class="layer-disc" />; })}
  <g>{links.map((link, index) => <line class:list={['link-flow', link.ring === 1 && 'is-flowing']} data-link-ring={link.ring} x1={link.from.x} y1={link.from.y} x2={link.to.x} y2={link.to.y} stroke={link.ring === 1 ? colors[link.ring % 4] : 'var(--c-line-strong)'} opacity={link.ring === 1 ? 0.82 : 0.28} style={`animation-delay:${(index % 6) * -0.7}s`} />)}</g>
  {layers.map((_, i) => <g data-ring={i} class:list={['layer-ring-group', i === 1 && 'is-active']} style={`color:${colors[i % 4]}`}><circle data-ring-circle cx="340" cy="225" r={(radii[i] ?? 54 + i * 42) * (i === 1 ? 1.08 : 1)} fill="none" stroke={colors[i % 4]} stroke-opacity={i === 1 ? 1 : 0.32} stroke-width={i === 1 ? 1.8 : 1} class="layer-ring" /><g class:list={['packet-orbit', i === 1 && 'is-flowing']} style={`--orbit-dur:${16 + i * 4}s;--orbit-dir:${i % 2 ? 'reverse' : 'normal'}`}><circle data-packet cx={340 + (radii[i] ?? 54 + i * 42) * (i === 1 ? 1.08 : 1)} cy="225" r="4.5" fill={colors[i % 4]} opacity={i === 1 ? 0.95 : 0.28} class="packet" /></g></g>)}
  {layers.flatMap((_, ring) => Array.from({ length: 6 + ring * 2 }, (_, node) => <circle data-node-ring={ring} data-node-index={node} cx={point(ring, node).x} cy={point(ring, node).y} r={ring === 1 ? 3.2 : 2.2} fill={colors[ring % 4]} opacity={ring === 1 ? 0.85 : 0.24} class="layer-node" />))}
  {layers.map((layer, i) => { const radius = (radii[i] ?? 54 + i * 42) * (i === 1 ? 1.08 : 1); return <text data-index-ring={i} x={340 - (radius - 14) * 0.62} y={225 - (radius - 14) * 0.62} fill={colors[i % 4]} opacity={i === 1 ? 1 : 0.4} class="plate-index">{layer.index}</text>; })}
</svg></div>
<style>
  .plate-root { position: relative; width: 100%; max-width: 680px; margin-inline: auto; aspect-ratio: 680 / 450; overflow: hidden; user-select: none; }
  .layer-disc, .layer-ring, .layer-node, .link-flow, .packet, .plate-index { transition: opacity 260ms ease, stroke-opacity 260ms ease, stroke-width 260ms ease, fill-opacity 260ms ease; }
  .plate-index { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.12em; text-anchor: middle; dominant-baseline: central; }
  .link-flow { stroke-dasharray: 4 7; }
  .layer-ring-group.is-active .layer-ring { filter: drop-shadow(0 0 8px currentColor); }
  .packet { filter: drop-shadow(0 0 4px currentColor); }
  @media (prefers-reduced-motion: no-preference) { .link-flow.is-flowing { animation: link-drift 6.4s linear infinite; } .packet-orbit.is-flowing { transform-box: view-box; transform-origin: 340px 225px; animation: packet-orbit var(--orbit-dur, 18s) linear infinite; animation-direction: var(--orbit-dir, normal); } }
  .plate-root.is-paused *, .plate-root.is-paused { animation-play-state: paused !important; }
  @keyframes link-drift { to { stroke-dashoffset: -22; } }
  @keyframes packet-orbit { to { transform: rotate(360deg); } }
</style>
