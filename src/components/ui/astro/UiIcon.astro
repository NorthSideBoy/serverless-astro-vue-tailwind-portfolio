---
import type { IconName } from '@/components/ui/icon-names';
import { brandIcons, isBrandIcon } from '@/components/ui/brand-icons';
import { uiIconComponents } from './icon-map';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 20, strokeWidth = 1.6, class: className } = Astro.props;
const brandIcon = isBrandIcon(name) ? brandIcons[name] : null;
const IconComponent = isBrandIcon(name) ? null : uiIconComponents[name];
---

{brandIcon ? (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
    class={className}
    data-icon={name}
  >
    <path d={brandIcon} />
  </svg>
) : IconComponent ? (
  <IconComponent
    size={size}
    stroke-width={strokeWidth}
    class={className}
    aria-hidden="true"
    focusable="false"
    data-icon={name}
  />
) : null}
