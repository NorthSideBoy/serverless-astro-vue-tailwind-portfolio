---
import type { Locale } from '../data/content';
import { content } from '../data/content';
import type { Project } from '../data/projects';
import type { ExperienceEntry } from '../data/experience';
import type { Testimonial } from '../data/testimonials';
import { projectAnchor, experienceAnchor, reviewAnchor } from '../data/anchors';
import { experiencesForProject, reviewsForProject } from '../data/relations';
import { primaryProjectLink } from '../data/projectLinks';
import UiIcon from './ui/UiIcon.astro';

interface Props { project: Project; locale: Locale; experiences: ExperienceEntry[]; reviews: Testimonial[] }
const { project, locale, experiences, reviews } = Astro.props;
const copy = content[locale];
const primaryLink = primaryProjectLink(project);
const relatedExperiences = experiencesForProject(project, experiences);
const relatedReviews = reviewsForProject(project.slug, reviews);
const hasRelations = relatedExperiences.length + relatedReviews.length > 0;
const metaPeriod = [project.context[locale], project.period?.[locale], project.platforms?.join(' · ')].filter(Boolean).join(' · ');
const repoLine = project.repos?.length ? project.repos.join(' · ') : project.meta;
const caseHref = project.featured ? `${locale === 'en' ? '/en/' : '/'}#${projectAnchor(project.slug)}` : null;
const visibleTech = project.tech.slice(0, 3);
---
<article
  id={projectAnchor(project.slug)} tabindex="-1" data-project-card
  data-project-kind={project.collaboration ? 'collaborations' : 'own'}
  class="group relative flex flex-col scroll-mt-28 border border-line bg-panel/10 transition-colors hover:border-soft/50 hover:bg-panel/20 focus-within:border-soft"
>
  <figure class="relative aspect-[16/10] overflow-hidden border-b border-line bg-sunken">
    {project.media.type === 'cover' ? <>
      <img src={project.media.dark} alt="" width={project.media.width} height={project.media.height} loading="lazy" decoding="async" class="theme-media-dark h-full w-full object-cover" />
      <img src={project.media.light} alt="" width={project.media.width} height={project.media.height} loading="lazy" decoding="async" class="theme-media-light h-full w-full object-cover" />
    </> : <div class="flex aspect-[16/10] w-full items-center justify-center bg-sunken p-6">
      {project.media.type === 'logo'
        ? <div class:list={['flex h-16 w-16 items-center justify-center border border-line p-3 md:h-20 md:w-20', project.media.surface === 'dark' ? 'bg-ink' : 'bg-white']}>
            <img src={project.media.src} alt="" width={project.media.width} height={project.media.height} loading="lazy" decoding="async" class="h-full w-full object-contain" />
          </div>
        : <span class="font-display text-[48px] font-bold leading-none tracking-[-0.05em] text-soft/85" aria-hidden="true">{project.media.label}</span>}
    </div>}
  </figure>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      {project.featured && <span class="rounded-sm border border-line px-2 py-1 font-mono text-[10px] font-medium uppercase leading-none tracking-[0.08em] text-muted">{copy.projects.featuredLabel}</span>}
      {project.collaboration && <span class="rounded-sm border border-line px-2 py-1 font-mono text-[10px] font-medium uppercase leading-none tracking-[0.08em] text-muted">{copy.projects.collaborationLabel}</span>}
      <span class:list={['inline-flex items-center gap-1.5 rounded-sm border px-2 py-1 font-mono text-[10px] font-medium uppercase leading-none tracking-[0.08em]', project.visibility === 'public' ? 'border-soft/45 text-soft' : 'border-line text-muted']}>
        <span class:list={['h-1 w-1 rounded-full', project.visibility === 'public' ? 'bg-status' : 'bg-muted']} aria-hidden="true" />
        {project.visibility === 'public' ? copy.projects.publicLabel : copy.projects.privateLabel}
      </span>
    </div>
    <h2 class="mt-3 font-display text-[18px] font-semibold leading-[1.2] tracking-[-0.02em] text-ink md:text-[19px]">
      {primaryLink ? <a href={primaryLink.href} target="_blank" rel="noopener noreferrer" class="inline-block min-h-11 py-2 transition hover:text-soft">
        {project.title[locale]} <span class="sr-only">({copy.ui.opensInNewTab})</span>
      </a> : project.title[locale]}
    </h2>
    <p class:list={['mt-2 text-[13.5px] leading-[1.65] text-muted', { 'line-clamp-3': project.featured }]}>{(project.description ?? project.summary)[locale]}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {visibleTech.map((tech) => <span class="inline-flex items-center rounded-sm border border-line px-2.5 py-1 font-mono text-[10.5px] font-medium uppercase leading-none tracking-[0.08em] text-muted">{tech}</span>)}
      {project.tech.length > visibleTech.length && <span class="inline-flex items-center rounded-sm border border-line px-2.5 py-1 font-mono text-[10.5px] font-medium uppercase leading-none tracking-[0.08em] text-muted">+{project.tech.length - visibleTech.length}</span>}
    </div>
    <div class="mt-auto pt-4">
      <div class="border-t border-line pt-3">
        {hasRelations && <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-1.5">
          <span class="shrink-0 font-mono text-[10px] uppercase leading-none tracking-[0.14em] text-muted">{copy.projects.relationsLabel}</span>
          {relatedExperiences.map((entry) => <a href={`${locale === 'en' ? '/en/' : '/'}#${experienceAnchor(entry.id)}`} class="inline-flex min-h-8 items-center gap-1.5 text-[11.5px] leading-snug text-soft hover:text-ink" aria-label={`${copy.projects.experienceLabel}: ${entry.org}, ${entry.role}`}>{entry.org} <UiIcon name="arrow-up" size={11} /></a>)}
          {relatedReviews.map((review) => <a href={`${locale === 'en' ? '/en/' : '/'}#${reviewAnchor(review.id)}`} class="inline-flex min-h-8 items-center gap-1.5 text-[11.5px] leading-snug text-soft hover:text-ink" aria-label={`${copy.projects.reviewLabel}: ${review.author.firstName} ${review.author.lastName}`}><img src={review.author.photo} alt="" width="20" height="20" loading="lazy" class="h-5 w-5 rounded-full object-cover" />{review.author.firstName} <UiIcon name="arrow-down" size={11} /></a>)}
        </div>}
        <p class="font-mono text-[10.5px] uppercase leading-relaxed tracking-[0.06em] text-muted">{metaPeriod}</p>
        {project.role && <p class="mt-1 font-mono text-[10.5px] uppercase leading-relaxed tracking-[0.06em] text-ink/85">{project.role[locale]}</p>}
        {repoLine && <p class="mt-1 break-words font-mono text-[10.5px] uppercase leading-relaxed tracking-[0.06em] text-muted">{repoLine}</p>}
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-3">
        {caseHref && <a href={caseHref} class="inline-flex min-h-11 items-center gap-1 font-mono text-[11px] uppercase tracking-[0.08em] text-soft hover:text-ink">{copy.projects.viewCase} <UiIcon name="arrow-right" size={12} /></a>}
        {project.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 font-mono text-[11px] uppercase tracking-[0.08em] text-soft hover:text-ink">{link.label[locale]} <UiIcon name="arrow-up-right" size={12} /><span class="sr-only">({copy.ui.opensInNewTab})</span></a>)}
        {!caseHref && !project.links.length && project.visibility === 'private' && <span class="font-mono text-[10px] uppercase text-muted">{copy.projects.privateCode}</span>}
      </div>
    </div>
  </div>
</article>
