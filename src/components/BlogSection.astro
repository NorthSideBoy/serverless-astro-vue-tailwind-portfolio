---
import type { Locale } from '../data/content';
import { content } from '../data/content';
import type { Article } from '../data/schemas/article';
import type { SiteSections } from '../data/schemas/siteSection';
import { articleReadTime, availableArticleLanguages, formatArticleDate, resolveArticleTranslation, sortArticles } from '../data/articleUtils';
import SectionHeader from './ui/SectionHeader.astro';
import UiIcon from './ui/UiIcon.astro';

interface Props { locale: Locale; articles: Article[]; section: SiteSections['blog'] }
const { locale, articles, section } = Astro.props;
const copy = content[locale];
const blog = locale === 'en' ? '/en/blog/' : '/blog/';
const latest = sortArticles(articles).slice(0, 3).map((post) => ({ post, translation: resolveArticleTranslation(post, locale) }));
const languageLabel = locale === 'es' ? 'Idiomas disponibles' : 'Available languages';
---
<section id="blog" class="section-pad border-t border-line bg-section" aria-labelledby="blog-title">
  <div class="shell">
    <SectionHeader seal="九" eyebrow={section[locale].eyebrow} title={section[locale].title} lead={section[locale].lead} titleId="blog-title" signal />
    <div class="grid gap-4 md:grid-cols-3 md:gap-5">
      {latest.map(({ post, translation }, index) => <a href={`${blog}${post.slug}`} data-blog-card class:list={['blog-card group relative flex flex-col overflow-hidden border border-line bg-panel/15 p-5 hover:border-line-strong md:p-6', index === 0 ? 'dot-corner' : '']} style={`--reveal-order:${index}`}>
        <span class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-gradient-to-r from-soft/70 via-aqua/60 to-transparent transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true" />
        <span class="blog-card__register" aria-hidden="true" />
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">{formatArticleDate(post.publishedAt, locale)} · {articleReadTime(translation)} {copy.blog.minLabel}</p>
          <p class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
            <span lang={translation.lang}>{translation.category}</span>
            {post.featured && <span class="border border-soft/40 px-1.5 py-0.5 text-[10px] text-soft">{copy.blogPage.highlighted}</span>}
            <span class="inline-flex flex-wrap gap-1" aria-label={languageLabel}>{availableArticleLanguages(post).map((language) => <span class="border border-line px-1.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted">{language.toUpperCase()}</span>)}</span>
          </p>
        </div>
        <h3 class="mt-6 font-display text-[18px] font-semibold leading-[1.35] tracking-[-0.01em] text-ink transition group-hover:text-soft md:text-[19px]"><span lang={translation.lang}>{translation.title}</span></h3>
        <p class="mt-3 line-clamp-3 text-[13px] leading-[1.65] text-muted"><span lang={translation.lang}>{translation.excerpt}</span></p>
        <div class="mt-auto flex items-center justify-between gap-2 border-t border-line pt-4 md:mt-8"><span class="font-mono text-[10px] uppercase tracking-[0.08em] text-muted">{copy.blog.readMore}</span><UiIcon name="arrow-right" size={14} class="text-muted transition group-hover:translate-x-1 group-hover:text-soft" /></div>
      </a>)}
    </div>
    {latest.length > 0 && <div class="mt-10 flex justify-end"><a href={blog} class="btn-ghost">{copy.blog.viewAll} <UiIcon name="arrow-right" size={15} /></a></div>}
  </div>
</section>

<style>
  .blog-card__register { position: absolute; top: 0; right: 0; left: 0; height: 1px; opacity: 0; transform: scaleX(0); transform-origin: left center; background-image: linear-gradient(to right, var(--c-soft), var(--c-aqua) 58%, transparent 100%); }
  @media (prefers-reduced-motion: no-preference) {
    .blog-card { transition: opacity 480ms cubic-bezier(0.16,1,0.3,1) calc(var(--reveal-order, 0) * 70ms), transform 480ms cubic-bezier(0.16,1,0.3,1) calc(var(--reveal-order, 0) * 70ms), border-color 180ms ease; }
    .blog-card.is-armed { opacity: 0; transform: translate3d(0, 10px, 0); transition: none; }
    .blog-card.is-shown .blog-card__register { animation: blog-register 960ms cubic-bezier(0.16,1,0.3,1) calc(var(--reveal-order, 0) * 70ms) both; }
  }
  @keyframes blog-register { 0% { opacity: 0; transform: scaleX(0); } 16% { opacity: 0.9; } 60% { opacity: 0.9; transform: scaleX(1); } 100% { opacity: 1; transform: scaleX(1); } }
</style>
