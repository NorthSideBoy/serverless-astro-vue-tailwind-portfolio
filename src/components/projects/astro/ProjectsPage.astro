---
import SiteHeader from '@/components/chrome/astro/SiteHeader.astro';
import SiteFooter from '@/components/chrome/astro/SiteFooter.astro';
import ProjectsIndex from '@/components/islands/projects/ProjectsIndexIsland.vue';
import Layout from '@/layouts/Layout.astro';
import { loadContent } from '@/lib/server/content';
import { content, type Locale } from '@/data/content';
import { buildProjectsGraph } from '@/lib/seo';
const { locale } = Astro.props as { locale: Locale };
const path = Astro.url.pathname;
const data = await loadContent();
const copy = content[locale];
const index = data.sections.projects[locale].index;
const projectsTitle = index?.title ?? data.sections.projects[locale].title;
const projectsDescription = index?.meta?.description ?? data.sections.projects[locale].lead;
const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = buildProjectsGraph({
  site,
  locale,
  copy,
  projects: data.projects,
  title: projectsTitle,
  description: projectsDescription,
});
---
<Layout
  locale={locale}
  type="website"
  title={index?.meta?.title}
  description={index?.meta?.description}
  jsonLd={jsonLd}
>
  <SiteHeader page="projects" locale={locale} path={path} />
  <ProjectsIndex locale={locale} page="projects" path={path} content={{ sections: data.sections, projects: data.projects, experiences: data.experience, reviews: data.reviews }} client:load />
  <SiteFooter page="projects" locale={locale} path={path} />
</Layout>
