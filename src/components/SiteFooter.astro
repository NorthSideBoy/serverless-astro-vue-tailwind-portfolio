---
import SiteFooterIsland from './islands/SiteFooterIsland.vue';
import { content, type Locale } from '../data/content';

interface Props {
  locale: Locale;
  page?: 'home' | 'projects' | 'blog' | 'article' | 'not-found';
  path: string;
}

const { locale, page = 'home', path } = Astro.props;
const copy = content[locale];
---

<SiteFooterIsland locale={locale} page={page} path={path} client:visible={{ rootMargin: '200px' }}>
  <div slot="contact">
    <p class="mono-label text-muted">{copy.footer.contactLabel}</p>
    <div class="mt-4 flex flex-col items-start gap-2.5">
      <a href="mailto:saidlucena519@gmail.com" class="text-[12.5px] text-muted transition hover:text-soft">
        saidlucena519@gmail.com
      </a>
      <p class="text-[12.5px] text-muted">Caracas, Venezuela</p>
      <p class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted">UTC−4 · VET</p>
      <p class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted">{copy.footer.meta}</p>
    </div>
  </div>
</SiteFooterIsland>
