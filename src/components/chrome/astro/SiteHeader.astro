---
import LocaleSwitch from './LocaleSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import UiIcon from '@/components/ui/astro/UiIcon.astro';
import { content, type Locale } from '@/data/content';
interface Props { locale: Locale; page?: 'home' | 'projects' | 'blog' | 'article' | 'reviews' | 'review-panel' | 'not-found'; path: string }
const { locale, page = 'home', path } = Astro.props;
const copy = content[locale];
const home = locale === 'en' ? '/en/' : '/';
const target = (id: string) => id === 'projects' && page === 'projects' ? `${locale === 'en' ? '/en' : ''}/proyectos/` : id === 'blog' && (page === 'blog' || page === 'article') ? `${locale === 'en' ? '/en' : ''}/blog/` : `${home}#${id}`;
const current = (id: string) => id === 'projects' && page === 'projects' || id === 'blog' && (page === 'blog' || page === 'article');
---
<header class="site-header sticky top-0 z-50 border-b border-transparent bg-page/75 backdrop-blur-md transition-colors duration-200" data-page={page}>
  <div class="shell flex h-[var(--header-bar-height)] items-center justify-between gap-4">
    <a href={home} data-home-link class="group flex min-w-0 items-center gap-3" aria-current={page === 'home' ? 'page' : undefined}><span class="shrink-0 font-serif text-[23px] font-black leading-none tracking-[-0.04em] text-ink transition group-hover:text-soft xl:text-[25px]">NSB</span><span class="flex min-w-0 flex-col gap-1 font-mono leading-none text-muted transition group-hover:text-ink"><span class="truncate text-[10px] font-medium tracking-[0.04em] sm:text-[11px]">NorthSideBoy</span><span class="truncate text-[10px] tracking-[0.04em]">Said Lucena</span></span></a>
    <nav class="ml-auto hidden items-center gap-6 xl:flex" aria-label={copy.nav.navLabel}>{copy.nav.links.map((link) => <a href={target(link.id)} data-nav-id={link.id} aria-current={current(link.id) ? 'page' : undefined} class:list={['nav-link relative py-2 font-mono text-[11.5px] font-medium uppercase tracking-[0.07em] transition-colors', current(link.id) ? 'text-soft' : 'text-muted hover:text-ink']}>{link.label}<span class:list={['nav-underline absolute inset-x-0 -bottom-0.5 h-px origin-left bg-soft transition-transform duration-200', current(link.id) ? 'scale-x-100' : 'scale-x-0']} aria-hidden="true" /></a>)}</nav>
    <div class="ml-2 flex shrink-0 items-center gap-2 md:ml-6 md:gap-2.5"><div class="hidden md:block"><LocaleSwitch locale={locale} path={path} /></div><div class="hidden md:block"><ThemeToggle locale={locale} /></div><button type="button" data-menu-toggle class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-panel/20 text-soft transition hover:border-soft xl:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={copy.nav.openMenu} data-open-label={copy.nav.openMenu} data-close-label={copy.nav.closeMenu}><span data-menu-icon><UiIcon name="menu" size={18} /></span><span data-close-icon hidden><UiIcon name="x" size={18} /></span></button></div>
  </div>
  <div id="mobile-menu" tabindex="-1" hidden class="mobile-menu absolute inset-x-0 top-full flex h-[calc(100dvh-var(--header-bar-height))] flex-col overflow-hidden border-b border-line bg-page xl:hidden"><nav class="shell flex min-h-0 flex-1 flex-col overflow-y-auto py-5" aria-label={copy.nav.navLabel}>{copy.nav.links.map((link) => <a href={target(link.id)} data-nav-id={link.id} aria-current={current(link.id) ? 'page' : undefined} class:list={['mobile-menu-link block border-b border-line py-4 font-display text-[22px] font-semibold tracking-[-0.01em] transition hover:text-soft', current(link.id) ? 'text-soft' : 'text-ink']}>{link.label}</a>)}</nav><div class="shrink-0 border-t border-line bg-page md:hidden"><div class="mobile-menu-controls shell flex items-center justify-between py-3"><LocaleSwitch locale={locale} path={path} /><ThemeToggle locale={locale} /></div></div></div>
</header>
<script>import '@/scripts/site-chrome';</script>
<style>
  .site-header { --header-bar-height: 88px; }
  @media (min-width: 1280px) { .site-header { --header-bar-height: 120px; } }
  @media (max-height: 520px) { .site-header { --header-bar-height: 64px; } .mobile-menu-link { padding-block: 0.6rem; font-size: 17px; } .mobile-menu-controls { padding-block: 0.375rem; } }
  .mobile-menu[hidden], [data-close-icon][hidden], [data-menu-icon][hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]):not([data-closing]) { animation: drawer-enter 180ms ease both; }
    .mobile-menu[data-closing] { animation: drawer-leave 180ms ease both; }
  }
  @keyframes drawer-enter { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @keyframes drawer-leave { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-8px); } }
</style>
