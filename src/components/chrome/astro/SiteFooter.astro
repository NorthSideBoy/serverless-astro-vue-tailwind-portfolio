---
import LocaleSwitch from './LocaleSwitch.astro';
import { content, type Locale } from '@/data/content';
interface Props { locale: Locale; page?: 'home' | 'projects' | 'blog' | 'article' | 'reviews' | 'review-panel' | 'not-found'; path: string }
const { locale, path } = Astro.props;
const copy = content[locale];
const home = locale === 'en' ? '/en/' : '/';
---
<footer class="border-t border-line bg-page">
  <div class="shell py-14 md:py-16 xl:py-20">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1.1fr] md:gap-12">
       <div><a href={home} data-home-link class="inline-flex items-center gap-3"><span class="font-serif text-[26px] font-black leading-none tracking-[-0.04em] text-ink">SL</span><span class="sr-only">{copy.nav.homeLabel}</span><span class="h-3.5 w-px bg-line-strong/60" aria-hidden="true" /><span class="seal-glyph text-[19px] leading-none text-soft" aria-hidden="true">設計</span></a><p class="type-support mt-5 max-w-[320px] leading-[1.7] text-muted">{copy.footer.tagline}</p></div>
       <div><p class="mono-label text-muted">{copy.footer.sectionsLabel}</p><nav class="mt-4 flex flex-col items-start gap-2.5" aria-label={copy.footer.sectionsLabel}>{copy.nav.links.map((link) => <a href={`${home}#${link.id}`} class="type-action text-muted transition hover:text-soft">{link.label}</a>)}</nav></div>
       <div class="min-w-0"><p class="mono-label text-muted">{copy.footer.contactLabel}</p><div class="mt-4 flex min-w-0 flex-col items-start gap-2.5"><a href="mailto:saidlucena519@gmail.com" class="type-action max-w-full break-all text-muted transition hover:text-soft">saidlucena519@gmail.com</a><p class="type-support text-muted">Caracas, Venezuela</p><p class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted">UTC−4 · VET</p><p class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted">{copy.footer.meta}</p></div></div>
    </div>
    <div class="mt-12 flex flex-col gap-5 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between"><p class="font-mono text-[10px] uppercase tracking-[0.05em] text-muted">{copy.footer.copyright}</p><span class="seal-glyph hidden text-[17px] text-soft/80 sm:block" aria-hidden="true">構</span><LocaleSwitch locale={locale} path={path} /></div>
  </div>
</footer>
