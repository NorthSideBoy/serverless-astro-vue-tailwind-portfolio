---
import type { Locale } from '@/data/content';
import { content } from '@/data/content';
import PlateFrame from '@/components/ui/astro/PlateFrame.astro';
import UiIcon from '@/components/ui/astro/UiIcon.astro';
import SectionHeader from '@/components/ui/astro/SectionHeader.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const services = content[locale].services;
const lead = services.primary[0]!;
const others = services.primary.slice(1);
const home = locale === 'en' ? '/en/' : '/';
---
<section id="services" class="service-register dot-field dot-field--body relative overflow-hidden section-pad border-t border-line bg-page" aria-labelledby="services-title">
  <span class="dot-extra" style="--dot-extra-focus: 0% 50%;" aria-hidden="true" />
  <span class="dot-extra" style="--dot-extra-top: 24%; --dot-extra-focus: 100% 50%; --dot-extra-height: 620px; --dot-field-strength: 60%;" aria-hidden="true" />
  <div class="shell">
    <SectionHeader seal="二" eyebrow={services.eyebrow} title={services.title} lead={services.lead} titleId="services-title" signal />
    <PlateFrame>
      <div>
        <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3.5 md:px-6">
          <p class="mono-label text-soft">{services.primaryLabel}</p>
          <p class="font-mono text-[10px] tracking-[0.1em] text-muted" aria-hidden="true">{String(services.primary.length).padStart(2, '0')}</p>
        </div>
        <div class="grid gap-px bg-line">
          <article data-service class="service-item service-item--lead grid gap-6 bg-page p-6 md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] md:items-start md:gap-10 md:p-9" style="--service-delay:0ms">
            <div class="min-w-0">
              <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-soft">SRV {lead.index}</p>
              <h3 class="mt-4 max-w-[20ch] font-display text-[28px] font-semibold leading-[1.04] tracking-[-0.03em] text-ink md:text-[36px] xl:text-[42px]">{lead.title}</h3>
            </div>
            <div class="min-w-0 md:border-l md:border-line md:pl-8">
              <p class="max-w-[52ch] text-[14px] leading-[1.75] text-muted md:text-[15px]">{lead.description}</p>
              {lead.scope.length > 0 && <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2">{lead.scope.map((scope) => <li class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.07em] text-muted"><span class="h-1 w-1 shrink-0 bg-soft/60" aria-hidden="true" />{scope}</li>)}</ul>}
            </div>
          </article>
          <div class="grid gap-px bg-line md:grid-cols-2">
            {others.map((service, index) => <article data-service class="service-item flex h-full flex-col bg-page p-6 transition-colors hover:bg-panel/10 focus-within:bg-panel/10 md:p-7" style={`--service-delay:${(index + 1) * 55}ms`}>
              <div class="flex items-start justify-between gap-4">
                <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-soft">SRV {service.index}</p>
                <span class="mt-1.5 h-px w-8 bg-line-strong" aria-hidden="true" />
              </div>
              <h3 class="mt-4 max-w-[22ch] font-display text-[22px] font-semibold leading-[1.1] tracking-[-0.025em] text-ink md:text-[26px]">{service.title}</h3>
              <p class="mt-3 max-w-[46ch] text-[13.5px] leading-[1.7] text-muted md:text-[14.5px]">{service.description}</p>
              {service.scope.length > 0 && <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2">{service.scope.map((scope) => <li class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.07em] text-muted"><span class="h-1 w-1 shrink-0 bg-soft/60" aria-hidden="true" />{scope}</li>)}</ul>}
            </article>)}
          </div>
        </div>
        <div class="border-t border-line bg-page">
          <div class="px-5 py-4 md:px-6">
            <h3 id="services-complementary-title" class="mono-label text-soft">{services.complementaryLabel}</h3>
          </div>
          <div class="grid gap-px bg-line sm:grid-cols-2 xl:grid-cols-4">
            {services.complementary.map((service, index) => <article data-service class="service-item flex h-full flex-col bg-page p-4 transition-colors hover:bg-panel/10 focus-within:bg-panel/10 md:p-5" style={`--service-delay:${Math.min((index + services.primary.length) * 55, 220)}ms`} aria-labelledby={`service-${service.index}`}>
              <div class="flex items-start justify-between gap-3">
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted">SRV {service.index}</p>
                <span class="mt-1.5 h-px w-6 bg-line-strong" aria-hidden="true" />
              </div>
              <h4 id={`service-${service.index}`} class="mt-3.5 font-display text-[16px] font-semibold leading-[1.2] tracking-[-0.01em] text-ink">{service.title}</h4>
              <p class="mt-2 text-[13px] leading-[1.65] text-muted">{service.description}</p>
            </article>)}
          </div>
        </div>
      </div>
    </PlateFrame>
    <div class="mt-8 flex flex-col items-start gap-5 border-t border-line pt-7 md:mt-10 md:items-end md:pt-8">
      <a href={`${home}#contact`} class="btn-primary group w-full shrink-0 sm:w-auto">{services.ctaAction} <UiIcon name="arrow-right" size={15} class="transition group-hover:translate-x-0.5" /></a>
    </div>
  </div>
</section>

<style>
  .service-item { height: 100%; }
  .service-item--lead { background-color: color-mix(in srgb, var(--c-panel) 8%, var(--c-page)); }
  .service-item--lead:hover { background-color: color-mix(in srgb, var(--c-panel) 16%, var(--c-page)); }
  @media (prefers-reduced-motion: no-preference) {
    .service-item {
      transition:
        opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
        background-color 180ms ease;
      transition-delay:
        var(--service-delay, 0ms), var(--service-delay, 0ms), 0ms;
    }
    .service-item.is-armed {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
      transition: none;
    }
  }
</style>
