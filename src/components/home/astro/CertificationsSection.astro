---
import type { Locale } from '@/data/content';
import type { SiteSections } from '@/data/schemas/siteSection';
import type { CertificationEntry } from '@/data/schemas/certification';
import SectionHeader from '@/components/ui/astro/SectionHeader.astro';
import UiIcon from '@/components/ui/astro/UiIcon.astro';

interface Props { section: SiteSections['certifications']; items: CertificationEntry[]; locale: Locale }
const { items, locale, section: sectionCopy } = Astro.props;
const section = sectionCopy[locale];
---
<section id="certifications" class="section-pad border-t border-line bg-section" aria-labelledby="certifications-title">
  <div class="shell">
    <SectionHeader seal="八" eyebrow={section.eyebrow} title={section.title} lead={section.lead} titleId="certifications-title" />
    <div class="border-t border-line">
      {items.map((item, index) => <article data-certification-item class="certification-item relative grid grid-cols-[44px_minmax(0,1fr)] gap-x-4 gap-y-2 border-b border-line py-4 md:grid-cols-[44px_minmax(0,1fr)_auto] md:items-start md:gap-6 md:py-6" style={`--reveal-order:${index}`}>
        <span class="certification-item__trace" aria-hidden="true" />
        <span class:list={['row-span-2 inline-flex h-9 w-9 items-center justify-center self-start rounded-md border border-line font-mono text-[10px] md:row-span-1 md:h-auto md:w-auto md:justify-start md:border-0', index === 0 ? 'text-soft' : 'text-muted']}>{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="font-display text-[18px] font-semibold leading-snug text-ink md:text-[20px]">{item.title}</h3>
          <p class="mt-1.5 font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted">{item.provider}</p>
        </div>
        <div class="col-start-2 flex flex-wrap items-center gap-x-5 gap-y-2 md:col-start-3 md:row-start-1 md:flex-col md:items-end md:gap-1.5 md:text-right">
          <p class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted">{item.date[locale]}</p>
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="group inline-flex min-h-11 max-w-full items-center gap-1 break-all font-mono text-[11px] tracking-[0.02em] text-soft transition hover:text-ink">{item.credentialId} <UiIcon name="arrow-up-right" size={11} class="shrink-0 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></a>
        </div>
      </article>)}
    </div>
  </div>
</section>

<style>
  .certification-item__trace { position: absolute; top: 0; right: 0; left: 0; height: 1px; opacity: 0; transform: scaleX(0); transform-origin: left center; background-image: linear-gradient(to right, transparent, var(--c-soft) 18%, var(--c-aqua) 82%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .certification-item > *:not(.certification-item__trace) { transition: opacity 440ms cubic-bezier(0.16,1,0.3,1), transform 440ms cubic-bezier(0.16,1,0.3,1); transition-delay: calc(var(--reveal-order, 0) * 55ms); }
    .certification-item.is-armed > *:not(.certification-item__trace) { opacity: 0; transform: translate3d(0, 8px, 0); transition: none; }
    .certification-item.is-shown .certification-item__trace { animation: certification-trace 900ms cubic-bezier(0.16,1,0.3,1) calc(var(--reveal-order, 0) * 55ms) both; }
  }
  @keyframes certification-trace { 0% { opacity: 0; transform: scaleX(0); } 16% { opacity: 0.85; } 64% { opacity: 0.85; transform: scaleX(1); } 100% { opacity: 1; transform: scaleX(1); } }
</style>
