---
import SiteHeader from '@/components/chrome/astro/SiteHeader.astro';
import SiteFooter from '@/components/chrome/astro/SiteFooter.astro';
import Hero from './HeroSection.astro';
import Stats from './StatsSection.astro';
import AboutSection from './AboutSection.astro';
import ServicesSection from './ServicesSection.astro';
import Skills from './SkillsSection.astro';
import StackSection from '@/components/islands/home/StackContent.vue';
import ExperienceSection from '@/components/islands/home/ExperienceContent.vue';
import Projects from '@/components/islands/projects/ProjectsIsland.vue';
import EducationSection from '@/components/islands/home/EducationContent.vue';
import CertificationsSection from '@/components/islands/home/CertificationsContent.vue';
import BlogSection from '@/components/islands/blog/BlogContent.vue';
import Testimonials from '@/components/islands/home/TestimonialsIsland.vue';
import Contact from './ContactSection.astro';
import Layout from '@/layouts/Layout.astro';
import { loadContent } from '@/lib/server/content';
import { content, type Locale } from '@/data/content';
import { homeProjectSubset } from '@/data/projects';
import { buildHomeGraph } from '@/lib/seo';

const { locale } = Astro.props as { locale: Locale };
const path = Astro.url.pathname;
const data = await loadContent();
const copy = content[locale];
const site = Astro.site ?? new URL(Astro.url.origin);
const homeProjects = homeProjectSubset(data.projects);
const knowsAbout = data.technologies
  .filter((technology) => technology.core)
  .map((technology) => technology.name);
const jsonLd = buildHomeGraph({ site, locale, copy, knowsAbout });
const ready = { loading: false, error: null };
---
<Layout locale={locale} type="website" jsonLd={jsonLd}>
  <SiteHeader page="home" locale={locale} path={path} />
  <main id="main">
    <Hero locale={locale} />
    <Stats locale={locale} />
    <AboutSection locale={locale} />
    <ServicesSection locale={locale} />
    <Skills locale={locale} />
    <StackSection locale={locale} groups={data.groups} technologies={data.technologies} section={data.sections.stack} />
    <ExperienceSection locale={locale} entries={data.experience} projects={data.projects} reviews={data.reviews} section={data.sections.experience} />
    <Projects locale={locale} content={{ projects: homeProjects, experiences: data.experience, reviews: data.reviews, section: data.sections.projects, ...ready }} client:visible={{ rootMargin: '200px' }} />
    <EducationSection locale={locale} items={data.education} section={data.sections.education} />
    <CertificationsSection locale={locale} items={data.certifications} section={data.sections.certifications} />
    <BlogSection locale={locale} articles={data.articles} section={data.sections.blog} />
    <Testimonials locale={locale} path={path} content={{ items: data.reviews, experiences: data.experience, projects: data.projects, section: data.sections.reviews, ...ready }} client:idle={{ timeout: 1500 }} />
    <Contact locale={locale} />
  </main>
  <SiteFooter locale={locale} path={path} />
</Layout>

<script>
  import '@/scripts/reveal';
</script>
