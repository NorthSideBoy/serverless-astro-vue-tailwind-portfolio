---
import { content, type Locale } from '@/data/content';
import SectionHeader from '@/components/ui/astro/SectionHeader.astro';
import UiIcon from '@/components/ui/astro/UiIcon.astro';
import coreDark from '@/assets/images/core_dark.png';
import coreLight from '@/assets/images/core_light.png';
const { locale } = Astro.props as { locale: Locale };
const copy = content[locale].contact;
const email = 'saidlucena519@gmail.com';
---
<section id="contact" class="contact-texture dot-field dot-field--body section-pad relative overflow-hidden bg-section" aria-labelledby="contact-title">
  <span class="dot-extra" style="--dot-extra-top: 58%; --dot-extra-reach: 40% 90%; --dot-field-strength: 42%;" aria-hidden="true" />
  <span class="dot-extra" style="--dot-extra-top: 88%; --dot-extra-focus: 0% 50%; --dot-extra-reach: 36% 86%; --dot-extra-height: 480px; --dot-field-strength: 38%;" aria-hidden="true" />
  <span class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-soft/45 to-transparent" aria-hidden="true" />
  <img src={coreDark.src} alt="" aria-hidden="true" loading="lazy" decoding="async" width="1100" height="1100" class="theme-media-dark pointer-events-none absolute -right-28 top-28 hidden w-[340px] max-w-none opacity-20 md:block lg:w-[440px] lg:opacity-30" />
  <img src={coreLight.src} data-theme-core alt="" aria-hidden="true" loading="lazy" decoding="async" width="1100" height="1100" class="theme-media-light pointer-events-none absolute -right-28 top-28 hidden w-[340px] max-w-none opacity-20 md:block lg:w-[440px] lg:opacity-30" />
  <div class="shell relative"><SectionHeader seal="十一" eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} titleId="contact-title" signal />
    <div class="grid gap-10 lg:grid-cols-[minmax(0,620px)_minmax(0,420px)] lg:justify-between lg:gap-16 xl:gap-24">
      <div data-contact-panel class="contact-panel" style="--reveal-order:0"><h3 class="max-w-[620px] font-display text-[28px] font-semibold leading-[1.15] tracking-[-0.03em] text-ink md:text-[36px]">{copy.question}</h3><p class="mt-5 max-w-[520px] text-[16px] leading-[1.7] text-muted md:text-[17px]">{copy.paragraph}</p>
        <div class="mt-7 flex max-w-[720px] flex-col gap-2.5"><div class="relative flex items-stretch gap-2 md:max-w-[520px]"><span class="contact-copy-trace" data-active="false" aria-hidden="true" /><a href={`mailto:${email}`} aria-label={copy.emailAria} class="contact-pill min-w-0 flex-1"><span class="contact-pill-icon" aria-hidden="true"><UiIcon name="mail" size={11} /></span><span class="truncate">{email}</span></a><button type="button" data-copy-email data-email={email} class="contact-pill w-auto shrink-0 justify-center px-4" aria-label={copy.form.copyEmail} data-copied="false"><span data-copy-icon><UiIcon name="copy" size={13} /></span><span data-check-icon hidden><UiIcon name="check" size={13} /></span></button></div><div aria-live="polite" class="min-h-[16px]"><p data-copy-status data-success={copy.form.copied} data-failure={copy.form.copyFailed} class="font-mono text-[10.5px] uppercase tracking-[0.06em]"></p></div>
          <div class="my-2 flex flex-wrap gap-2">{copy.badges.map((badge) => <span class="rounded-full border border-line px-3 py-1.5 font-mono text-[11px] uppercase leading-none tracking-[0.05em] text-muted">{badge}</span>)}</div>
          <div class="grid gap-2.5 md:grid-cols-2"><a href="https://wa.me/584248887764" target="_blank" rel="noopener noreferrer" aria-label={copy.whatsappAria} class="contact-pill"><span class="contact-pill-icon" aria-hidden="true"><UiIcon name="whatsapp" size={11} /></span><span>+58 424 888 7764</span><UiIcon name="arrow-up-right" size={11} class="ml-auto shrink-0 text-muted" /></a><a href="https://github.com/NorthSideBoy" target="_blank" rel="noopener noreferrer" class="contact-pill"><span class="contact-pill-icon" aria-hidden="true"><UiIcon name="github" size={11} /></span><span>GitHub · NorthSideBoy</span><span class="sr-only">{copy.githubAria}</span><UiIcon name="arrow-up-right" size={11} class="ml-auto shrink-0 text-muted" /></a></div>
        </div>
      </div>
      <div data-contact-panel class="contact-panel border border-line/80 bg-panel/5 p-5 md:p-6 xl:p-7" style="--reveal-order:1"><form class="space-y-4" novalidate>
        {([
          { id: 'name', label: copy.form.nameLabel, placeholder: copy.form.namePlaceholder, type: 'text', autocomplete: 'name' },
          { id: 'email', label: copy.form.emailLabel, placeholder: copy.form.emailPlaceholder, type: 'email', autocomplete: 'email' },
          { id: 'subject', label: copy.form.subjectLabel, placeholder: copy.form.subjectPlaceholder, type: 'text', autocomplete: 'off' },
        ] as const).map((field) => <div><label for={`contact-${field.id}`} class="mb-2 block font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] text-muted">{field.label}</label><input id={`contact-${field.id}`} type={field.type} name={field.id} autocomplete={field.autocomplete} inputmode={field.id === 'email' ? 'email' : undefined} class="field" placeholder={field.placeholder} /></div>)}
        <div><label for="contact-message" class="mb-2 block font-mono text-[10.5px] font-medium uppercase tracking-[0.1em] text-muted">{copy.form.messageLabel}</label><textarea id="contact-message" name="message" rows="4" class="field min-h-[104px] resize-y" placeholder={copy.form.messagePlaceholder} /></div><button type="submit" class="inline-flex min-h-[52px] w-full items-center justify-center rounded-full border border-line px-7 text-[15px] font-semibold text-muted" disabled>{copy.form.submit}</button>
      </form></div>
    </div>
  </div>
</section>
<script>import '@/scripts/contact';</script>
<style>
  .contact-texture { --dot-field-focus: 0% 0%; --dot-field-reach: 40% 100%; --dot-field-strength: 48%; --dot-field-fade: 70%; }
  .contact-pill[data-copied='true'] { border-color: color-mix(in srgb, var(--c-soft) 70%, transparent); color: var(--c-soft); }
  .contact-copy-trace { position: absolute; inset-inline: 0; bottom: -7px; height: 1px; pointer-events: none; opacity: 0; transform: scaleX(0); transform-origin: left center; background-image: linear-gradient(90deg, transparent, var(--c-soft) 12%, var(--c-aqua) 82%, transparent); }
  @media (prefers-reduced-motion: no-preference) { .contact-copy-trace[data-active='true'] { animation: contact-copy-trace 560ms cubic-bezier(0.16,1,0.3,1) both; } .contact-panel { transition: opacity 480ms cubic-bezier(0.16,1,0.3,1) calc(var(--reveal-order, 0) * 80ms), transform 480ms cubic-bezier(0.16,1,0.3,1) calc(var(--reveal-order, 0) * 80ms); } .contact-panel.is-armed { opacity: 0; transform: translate3d(0,10px,0); transition: none; } }
  @keyframes contact-copy-trace { 0% { opacity: 0; transform: scaleX(0); } 18% { opacity: 1; } 72% { opacity: 1; transform: scaleX(1); } 100% { opacity: 0; transform: scaleX(1); } }
</style>
