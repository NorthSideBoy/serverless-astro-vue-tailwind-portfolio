---
import { content, type Locale } from '@/data/content';
const { locale } = Astro.props as { locale: Locale };
const stats = content[locale].stats;
---
<div class="border-b border-line bg-section"><div class="shell grid grid-cols-2 gap-x-6 gap-y-8 py-9 md:grid-cols-2 md:gap-0 md:py-11">
  {stats.map((stat, index) => <div class:list={['md:px-8', index > 0 ? 'md:border-l md:border-line' : 'md:pl-0', index === stats.length - 1 && 'md:pr-0']}><p class:list={['font-display text-[32px] font-bold leading-none tracking-[-0.04em] md:text-[40px] xl:text-[46px]', index === 1 ? 'text-soft' : 'text-ink']}><span data-scramble data-delay={Math.min(index * 70, 210)}><span class="sr-only">{stat.value}</span><span aria-hidden="true" class="tabular-nums">{stat.value}</span></span></p><p class="mt-2.5 max-w-[220px] font-mono text-[10px] leading-[1.55] text-muted md:text-[11px]">{stat.label}</p></div>)}
</div></div>
<script>import '@/scripts/scramble-stats';</script>
