---
import BlogBody from './BlogBody.astro';
import SiteHeader from '@/components/chrome/astro/SiteHeader.astro';
import SiteFooter from '@/components/chrome/astro/SiteFooter.astro';
import Layout from '@/layouts/Layout.astro';
import { loadContent } from '@/lib/server/content';
import type { Locale } from '@/data/content';
const { locale } = Astro.props as { locale: Locale };
const path = Astro.url.pathname;
const data = await loadContent();
---
<Layout locale={locale} title={data.sections.blog[locale].index?.meta?.title} description={data.sections.blog[locale].index?.meta?.description}>
  <SiteHeader page="blog" locale={locale} path={path} />
  <BlogBody locale={locale} sections={data.sections} articles={data.articles} />
  <SiteFooter page="blog" locale={locale} path={path} />
</Layout>
