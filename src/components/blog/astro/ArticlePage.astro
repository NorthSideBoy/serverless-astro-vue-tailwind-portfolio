---
import SiteHeader from '@/components/chrome/astro/SiteHeader.astro';
import SiteFooter from '@/components/chrome/astro/SiteFooter.astro';
import ArticleView from '@/components/islands/blog/ArticleContent.vue';
import Layout from '@/layouts/Layout.astro';
import { loadContent } from '@/lib/server/content';
import { resolveArticleTranslation } from '@/data/articleUtils';
import type { Locale } from '@/data/content';

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const path = Astro.url.pathname;
const data = await loadContent();
const article = data.articles.find((entry) => entry.slug === slug);
if (!article) throw new Error(`Article ${slug} is missing from the published collection`);
const translation = resolveArticleTranslation(article, locale);
---
<Layout locale={locale} title={`${translation.title} — ${article.author.name}`} description={translation.excerpt} alternates={Boolean(article.translations.es && article.translations.en)}>
  <SiteHeader page="article" locale={locale} path={path} />
  <div class="fixed inset-x-0 top-0 z-[70] h-[2px]" aria-hidden="true"><div data-reading-progress class="h-full origin-left scale-x-0" style="background-image:linear-gradient(90deg,var(--c-action),var(--c-action-2))" /></div>
  <ArticleView locale={locale} article={article} items={data.articles} />
  <SiteFooter page="article" locale={locale} path={path} />
</Layout>
<script>import '@/scripts/article-navigation';</script>
