# Required. Canonical domain used by canonical URLs, hreflang and sitemap.
# The build fails if it is missing. Set it in .env, the production environment and build:fixture.
SITE_URL=https://your-domain.example

# Required. Public base URL for dynamic media served from Cloudflare R2.
# Use the r2.dev URL today; switch to a custom domain later.
PUBLIC_MEDIA_URL=

# Required for visitor sign-in. These are public Firebase web values, not
# secrets; retrieve them with `npx firebase-tools apps:sdkconfig web`.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# EmailJS identifiers used by the browser. They are PUBLIC by design: Astro
# exposes them in the compiled JavaScript. Do not put the EmailJS private key
# here and do not treat these values as secrets. If a value is missing, that
# notification is skipped. Configure the recipient inside EmailJS.
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
PUBLIC_EMAILJS_REVIEW_TEMPLATE_ID=

# Server-only. Required only for future R2 media CRUD.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Firestore credentials: set all three to use a service account without a JSON file.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternatively, leave the three variables unset and use Application Default Credentials.

# Test-only. Builds the site from local fixtures instead of Firestore.
# Never deploy a build produced with this value.
# CONTENT_SOURCE=fixture
